---
import Layout from "../layouts/Layout.astro";
import { COMPANY, TEAM } from "../config/site";
import { addressLine, mapEmbedUrl, telHref } from "../lib/site.js";
---
<Layout>

  <div class="page-hero">
    <h1>Contact Us</h1>
    <p>Our team is here to help with product inquiries, quotes, and technical support.</p>
  </div>

  <div class="container">
    <div class="page-content">

      <!-- Team directory -->
      <h2>Our Team</h2>
      <div class="team-grid">
        {TEAM.map(m => (
          <div class="team-card">
            <h3>{m.name}</h3>
            <p class="title">{m.title}</p>
            <a href={`mailto:${m.email}`}>{m.email}</a>
          </div>
        ))}
      </div>

      <!-- Contact info + form -->
      <div class="contact-info-grid">
        <div class="info-box">
          <h3>Contact Information</h3>
          <div class="info-row"><span class="label">General</span><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></div>
          <div class="info-row"><span class="label">Address</span><span>{addressLine(COMPANY.address)}</span></div>
          <div class="info-row"><span class="label">Phone</span><a href={telHref(COMPANY.phone)}>{COMPANY.phone}</a></div>
          <div class="info-row"><span class="label">Toll Free</span><a href={telHref(COMPANY.tollFreeNumeric)}>{COMPANY.tollFree}</a></div>
          <div class="info-row"><span class="label">Fax</span><span>{COMPANY.fax}</span></div>
          <div class="info-row"><span class="label">ChemTrec</span><a href={telHref(COMPANY.chemtrec)}>{COMPANY.chemtrec}</a></div>
        </div>

        <div class="contact-form-card">
          <h3>Send a Message</h3>
          <form
            id="contact-form"
            action="https://formspree.io/f/mbdzpwoq"
            method="POST"
          >
            <div class="form-group">
              <label for="c-name">Name *</label>
              <input type="text" id="c-name" name="name" required />
            </div>
            <div class="form-group">
              <label for="c-company">Company</label>
              <input type="text" id="c-company" name="company" />
            </div>
            <div class="form-group">
              <label for="c-email">Email *</label>
              <input type="email" id="c-email" name="email" required />
            </div>
            <div class="form-group">
              <label for="c-phone">Phone</label>
              <input type="tel" id="c-phone" name="phone" />
            </div>
            <div class="form-group">
              <label for="c-message">Comments *</label>
              <textarea id="c-message" name="message" required></textarea>
            </div>
            <input type="hidden" name="_subject" value="Contact form submission – chem-is-try.com" />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit" class="btn btn-primary">Send Message</button>
            <div class="form-success" id="c-success" role="status" hidden>Thank you! We'll be in touch shortly.</div>
            <div class="form-error" id="c-error" role="alert" hidden>We could not send your message. Please email <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a> or call {COMPANY.tollFree}.</div>
          </form>
        </div>
      </div>

      <!-- Live Map -->
      <div class="map-block">
        <h2>Our Location</h2>
        <iframe
          src={mapEmbedUrl(COMPANY.address)}
          class="map-frame"
          width="100%"
          height="350"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="CHEM-IS-TRY Inc. location map"
        ></iframe>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { initForm } from "../lib/form-submit.js";

  initForm({ form: "contact-form", success: "c-success", error: "c-error" });
</script>
