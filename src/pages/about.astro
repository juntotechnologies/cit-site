---
import Layout from "../layouts/Layout.astro";
import { COMPANY, TEAM } from "../config/site";
import { addressLine, telHref } from "../lib/site.js";

const president = TEAM.find((member) => member.title === "President");
const slides = [
  { src: "/assets/about1.jpg", alt: "CHEM-IS-TRY laboratory" },
  { src: "/assets/about2.jpg", alt: "CHEM-IS-TRY facilities" },
  { src: "/assets/about3.jpg", alt: "CHEM-IS-TRY India operations" },
  { src: "/assets/about4.jpg", alt: "CHEM-IS-TRY lab work" },
  { src: "/assets/about5.jpg", alt: "CHEM-IS-TRY team" },
  { src: "/assets/about6.jpg", alt: "CHEM-IS-TRY cGMP facility" },
];
---
<Layout>

  <div class="page-hero">
    <h1>About Us</h1>
    <p>{COMPANY.tagline}.</p>
  </div>

  <div class="about-slider" id="about-slider" role="region" aria-roledescription="carousel" aria-label="Photos of CHEM-IS-TRY">
    <div class="slides">
      {slides.map((slide, index) => (
        <div class:list={["slide", index === 0 && "active"]}>
          <img {...(index === 0 ? { src: slide.src } : { "data-src": slide.src })} alt={slide.alt} width="1000" height="681" decoding="async" />
        </div>
      ))}
    </div>
    <button class="slider-btn prev" data-slider-prev aria-label="Previous slide">&#8249;</button>
    <button class="slider-btn next" data-slider-next aria-label="Next slide">&#8250;</button>
    <button class="slider-pause" data-slider-pause aria-pressed="false" aria-label="Pause slideshow"><span aria-hidden="true"></span></button>
    <div class="slider-dots">
      {slides.map((slide, index) => <button class:list={["slider-dot", index === 0 && "active"]} aria-label={`Slide ${index + 1}`}></button>)}
    </div>
  </div>

  <div class="container">
    <div class="page-content page-content--narrow">

      <h2>Who We Are</h2>
      <p>
        {COMPANY.name} – a specialty chemical company – located in Liberty Corporate Park,
        {COMPANY.address.city}, {COMPANY.address.state}, USA, focused on synthesizing wide varieties of aliphatic, aromatic, and
        heterocyclic organic molecules in the gram to kilogram range. We are involved in process
        development, scaling up the production of samples developed from custom synthesis to bulk
        manufacturing, and manufacturing fine chemicals and advanced organic intermediates.
      </p>
      <p>
        {COMPANY.name} also has an extension of its facility overseas where we carry out custom
        manufacturing of advanced organic intermediates. As part of our commitment to quality
        control, {COMPANY.name} has a state-of-the-art QC lab equipped with gas chromatography
        (GC), high-performance liquid chromatography (HPLC), and infrared spectroscopy (IR)
        instrumentation etc. In addition, we have a wet lab stocked with standard analytical
        instruments to support our custom synthesis projects and catalog business.
      </p>

      <h2>Helping the research and development community</h2>
      <p>Our services include:</p>
      <ul>
        <li>Development of new synthetic routes for organic molecules</li>
        <li>Synthesis of novel organic molecules</li>
        <li>Scale-up services (gram to kilogram range)</li>
        <li>Custom manufacturing services</li>
        <li>Process development</li>
        <li>Contract R &amp; D</li>
        <li>cGMP Lab and Manufacturing</li>
      </ul>

      <h2>Contact Information</h2>
      <div class="info-box">
        <div class="info-row"><span class="label">Address</span><span>{addressLine(COMPANY.address)}</span></div>
        <div class="info-row"><span class="label">Tel</span><a href={telHref(COMPANY.phone)}>{COMPANY.phone}</a></div>
        <div class="info-row"><span class="label">Toll Free</span><a href={telHref(COMPANY.tollFreeNumeric)}>{COMPANY.tollFree} ({COMPANY.tollFreeNumeric})</a></div>
        <div class="info-row"><span class="label">Fax</span><span>{COMPANY.fax} / {COMPANY.faxAlt}</span></div>
        <div class="info-row"><span class="label">Email</span><span><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>{president && <> / <a href={`mailto:${president.email}`}>{president.email}</a></>}</span></div>
      </div>

      <div class="actions actions--start">
        <a href="/rfq/" class="btn btn-primary">Request for Quotation</a>
        <a href="/products/" class="btn btn-outline">Browse Catalog</a>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { initSlider } from "../lib/slider.js";

  initSlider("about-slider", 4500);
</script>
