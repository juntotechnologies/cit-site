---
import Layout from "../layouts/Layout.astro";
import { publicServices } from "../data/services";
---
<Layout>

  <div class="page-hero">
    <h1>Our Services</h1>
    <p>From custom synthesis to bulk manufacturing — chemistry guaranteed.</p>
  </div>

  <div class="container">
    <div class="page-content">

      <p class="lead">
        CHEM-IS-TRY, Inc. offers comprehensive chemical services to the research, pharmaceutical,
        and industrial communities. Our in-house team of PhD and MS chemists bring decades of
        expertise to every project.
      </p>

      <div class="services-grid">
        {publicServices.map((service) => (
          <div class="service-card">
            <h2><a href={`/services/${service.slug}/`}>{service.title}</a></h2>
            <p>{service.shortDescription}</p>
            <a href={`/services/${service.slug}/`} class="learn-more" aria-label={`Learn more about ${service.title}`}>Learn more →</a>
          </div>
        ))}
      </div>

      <div class="callout callout--center">
        <h2>Ready to Start a Project?</h2>
        <p>Submit a Request for Quotation and our team will evaluate your project within 2–3 business days.</p>
        <div class="actions"><a href="/rfq/" class="btn btn-primary">Request for Quotation</a></div>
      </div>

    </div>
  </div>
</Layout>
