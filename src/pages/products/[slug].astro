---
import Layout from "../../layouts/Layout.astro";
import { COMPANY, SITE } from "../../config/site";
import { formulaToHtml } from "../../lib/formula.js";
import { getProductPath, getProductSlug } from "../../lib/product-url.js";
import { breadcrumbSchema, productDescription, productHeading, productSchema } from "../../lib/seo.js";
import { parseProducts, type Product } from "../../types/product";
import rawProducts from "../../../data/products.json";

export function getStaticPaths() {
  const products = parseProducts(rawProducts as unknown[]);
  return products.map((p) => {
    const slug = getProductSlug(p, products);
    return { params: { slug }, props: { product: p, path: getProductPath(p, products) } };
  });
}

interface Props { product: Product; path: string; }
const { product: p, path } = Astro.props;

const trail = [{ name: "Home", path: "/" }, { name: "Products", path: "/products/" }, { name: p.name ?? "Product", path }];
const records = [productSchema(SITE, p, path), breadcrumbSchema(SITE, trail)];
const ogImage = p.image_file ? `/images/${p.image_file}` : undefined;
const rfqHref = `/rfq/?product=${encodeURIComponent(p.name || "")}&cat=${encodeURIComponent(p.catalog_number || "")}&cas=${encodeURIComponent(p.cas || "")}`;
---
<Layout
  title={productHeading(p)}
  description={productDescription(COMPANY, p)}
  ogImage={ogImage}
  ogType="product"
  records={records}
>
  <div class="container">
    <div class="product-detail">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/products/">Products</a> › <span aria-current="page">{p.name}</span>
      </nav>

      <div class="product-layout">
        <!-- Structure image -->
        <div>
          <div class="product-structure">
            {p.image_file
              ? <img src={`/images/${p.image_file}`} alt={`Structure of ${p.name}`} decoding="async" />
              : <p class="muted">No structure image available</p>
            }
          </div>
          <div class="rfq-cta mt-2">
            <p>Interested in this product?</p>
            <a href={rfqHref} class="btn btn-primary">
              Request a Quote
            </a>
          </div>
        </div>

        <!-- Product info -->
        <div class="product-info">
          <h1>{p.name}</h1>

          <table class="product-table">
            {p.catalog_number && (
              <tr><th>Catalog #</th><td>{p.catalog_number}</td></tr>
            )}
            {p.cas && (
              <tr><th>CAS Number</th><td>{p.cas}</td></tr>
            )}
            {p.molecular_formula && (
              <tr>
                <th>Molecular Formula</th>
                <td set:html={formulaToHtml(p.molecular_formula)} />
              </tr>
            )}
            {p.molecular_weight && (
              <tr><th>Molecular Weight</th><td>{p.molecular_weight} g/mol</td></tr>
            )}
            {p.purity && (
              <tr><th>Purity</th><td>{p.purity}</td></tr>
            )}
            {p.grade && (
              <tr><th>Grade</th><td>{p.grade}</td></tr>
            )}
            {p.synonyms && (
              <tr><th>Synonyms</th><td>{p.synonyms}</td></tr>
            )}
          </table>

          {p.description && (
            <div>
              <h2 class="muted-heading">Description</h2>
              <p class="muted">{p.description}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>
