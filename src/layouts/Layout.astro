---
import { ClientRouter } from "astro:transitions";
import palette from "../styles/palette.css?raw";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { COMPANY, PRODUCT_TOTAL, SITE } from "../config/site";
import { brandColor } from "../lib/palette.js";
import { findPage, jsonLd, normalizePath, pageMeta, pageRecords } from "../lib/seo.js";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  records?: object[];
}
const props = Astro.props;
const path = normalizePath(Astro.url.pathname);
const stored = findPage(SITE, path);
const meta = pageMeta(SITE, PRODUCT_TOTAL, {
  path,
  title: props.title ?? stored?.title ?? COMPANY.name,
  description: props.description ?? stored?.description ?? COMPANY.tagline,
  ogImage: props.ogImage,
  ogType: props.ogType,
  noindex: props.noindex,
});
const records = props.records ?? (stored ? pageRecords(SITE, stored) : []);
const gaId = SITE.analytics.gaMeasurementId;
const gaScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${gaId}');
`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content={brandColor(palette)} />
  <meta name="description" content={meta.description} />
  {meta.noindex && <meta name="robots" content="noindex" />}
  <title>{meta.title}</title>
  <link rel="canonical" href={meta.canonical} />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:type" content={meta.ogType} />
  <meta property="og:url" content={meta.canonical} />
  <meta property="og:image" content={meta.ogImage} />
  <meta property="og:site_name" content={COMPANY.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={meta.title} />
  <meta name="twitter:description" content={meta.description} />
  <meta name="twitter:image" content={meta.ogImage} />
  {records.length > 0 && <script type="application/ld+json" set:html={jsonLd(records)} />}
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
  <script set:html={gaScript} />
  <link rel="icon" type="image/png" href="/favicon-cit.png?v=4" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=4" />
  <link rel="apple-touch-icon" href="/favicon-cit.png?v=4" />
  <ClientRouter />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
</body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
